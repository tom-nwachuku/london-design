{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://london-design.local/schemas/london-pack.schema.json",
  "title": "London Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "version",
    "mode",
    "brief",
    "session_lane",
    "reference_packs",
    "gates",
    "research",
    "creative_direction",
    "typography_color",
    "image_direction",
    "layout_mockups",
    "build_motion",
    "quality_review",
    "recommended_route_ref",
    "artifact_type",
    "conversation",
    "route_comparison",
    "font_options",
    "moodboard_tiles",
    "copy_blocks",
    "next_steps",
    "evidence_summary",
    "receipts"
  ],
  "properties": {
    "pack_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["scripted-local", "live-provider"] },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text", "digest", "source_label", "source_ref"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "source_label": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(/Users/|/tmp/|/private/|[A-Za-z]:[\\\\/])" }
        },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "session_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "label", "product_noun", "audience", "jobs", "rituals", "surfaces", "tensions", "tone", "avoid", "output_moments", "source_terms", "route_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "origin": { "const": "current_brief" },
        "label": { "type": "string", "minLength": 1 },
        "product_noun": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "jobs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rituals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "surfaces": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tensions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tone": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "avoid": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "output_moments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "source_terms": { "type": "string", "minLength": 1 },
        "route_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reference_packs": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "provider_selection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requested_provider": { "type": "string" },
        "selected_provider": { "type": "string" },
        "selected_reason": { "type": "string" },
        "allow_paid": { "type": "boolean" },
        "spend_limit_usd": { "type": "number" },
        "fallback_chain": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "setup_context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "env_file": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "path_label": { "type": "string" },
            "loaded_keys": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gateState" }
    },
    "research": {
      "type": "object",
      "required": ["audience", "category_tension", "evidence_plan"],
      "properties": {
        "audience": { "type": "string" },
        "category_tension": { "type": "string" },
        "evidence_plan": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceReference" }
        }
      }
    },
    "creative_direction": {
      "type": "object",
      "required": ["positioning", "voice", "concept_routes"],
      "properties": {
        "positioning": { "type": "string" },
        "voice": { "type": "string" },
        "concept_routes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "typography_color": {
      "type": "object",
      "required": ["type_system", "color_system", "accessibility_notes"],
      "properties": {
        "type_system": { "type": "string" },
        "color_system": { "type": "string" },
        "accessibility_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "image_direction": {
      "type": "object",
      "required": ["art_direction", "shot_list", "generation_constraints"],
      "properties": {
        "art_direction": { "type": "string" },
        "shot_list": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generation_constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "layout_mockups": {
      "type": "object",
      "required": ["routes", "wireframes", "components"],
      "properties": {
        "routes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "wireframes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "build_motion": {
      "type": "object",
      "required": ["prototype_plan", "motion_principles", "handoff_assets"],
      "properties": {
        "prototype_plan": { "type": "string" },
        "motion_principles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "handoff_assets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "quality_review": {
      "type": "object",
      "required": ["checks", "risks", "approval_summary"],
      "properties": {
        "checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approval_summary": { "type": "string" }
      }
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/receipt" }
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "category_assumption": { "type": "string" },
    "recommended_route_ref": { "type": "string", "minLength": 1 },
    "recommended_route": { "type": "string" },
    "artifact_type": { "enum": ["website", "app", "product", "brand", "generic"] },
    "aesthetic_void": { "type": "string" },
    "london_reframe": { "type": "string" },
    "vessel_interface_expression": { "type": "string" },
    "recurring_loop": { "type": "string" },
    "unboxing_first_moment": { "type": "string" },
    "anti_position": { "type": "string" },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/visualRoute" }
    },
    "brain_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/brainFinding" }
    },
    "image_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/brainFinding" }
    },
    "critique_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/brainFinding" }
    },
    "source_plan": {
      "type": "object"
    },
    "conversation": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/conversationEntry" }
    },
    "route_comparison": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routeComparison" }
    },
    "font_options": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fontRouteGroup" }
    },
    "moodboard_tiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/moodboardRouteGroup" }
    },
    "copy_blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/copyBlock" }
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nextStep" }
    },
    "evidence_summary": {
      "$ref": "#/$defs/evidenceSummary"
    },
    "grader": {
      "$ref": "#/$defs/grader"
    }
  },
  "$defs": {
    "conversationEntry": {
      "type": "object",
      "required": ["id", "order", "gate", "decision", "evidence_classes", "evidence_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "gate": { "type": "string", "minLength": 1 },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "decision": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" },
        "critique": { "type": "string" },
        "status": { "type": "string" },
        "answer_label": { "const": "London's read" },
        "honesty_badges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_classes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["london_brain_findings", "source_targets", "live_artifacts"],
          "properties": {
            "london_brain_findings": { "type": "integer", "minimum": 0 },
            "source_targets": { "type": "integer", "minimum": 0 },
            "live_artifacts": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "brain_queries": { "type": "array", "items": { "$ref": "#/$defs/brainQuery" } },
        "brain_findings": { "type": "array", "items": { "$ref": "#/$defs/brainFinding" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceInspection" } },
        "receipts": { "type": "array", "items": { "$ref": "#/$defs/receipt" } }
      }
    },
    "routeComparison": {
      "type": "object",
      "required": ["route_id", "title", "thesis", "best_for", "visual_world", "type", "palette_logic", "steal", "do_not_copy", "first_build_move", "risk"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "thesis": { "type": "string" },
        "best_for": { "type": "string" },
        "visual_world": { "type": "string" },
        "type": { "type": "string" },
        "palette_logic": { "type": "string" },
        "steal": { "type": "string" },
        "do_not_copy": { "type": "string" },
        "first_build_move": { "type": "string" },
        "risk": { "type": "string" }
      }
    },
    "fontRouteGroup": {
      "type": "object",
      "required": ["route_id", "route_title", "options"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "route_title": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/fontOption" }
        }
      }
    },
    "fontPreview": {
      "type": "object",
      "required": ["status", "delivery", "rendered_family", "source_label", "license_note"],
      "properties": {
        "status": { "enum": ["actual_loaded", "source_loaded", "fallback_approximation", "reference_capture", "reference_only"] },
        "delivery": { "enum": ["local_asset", "remote_font_file", "system_fallback", "reference_image", "reference_only"] },
        "display_state": { "enum": ["bundled_loaded", "source_loaded", "user_loaded", "reference_capture", "fallback_approximation", "reference_only"] },
        "rendered_family": { "type": "string", "minLength": 1 },
        "source_label": { "type": "string" },
        "license_note": { "type": "string" },
        "font_file_href": {
          "type": "string",
          "pattern": "^https://cdn\\.jsdelivr\\.net/fontsource/fonts/[A-Za-z0-9-]+@(?:latest|[0-9][A-Za-z0-9.-]*)/[A-Za-z0-9-]+\\.woff2$"
        },
        "css_hrefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://cdn\\.jsdelivr\\.net/fontsource/fonts/[A-Za-z0-9-]+@(?:latest|[0-9][A-Za-z0-9.-]*)/[A-Za-z0-9-]+\\.woff2$"
          }
        },
        "role_css_stacks": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "reference_visual": { "type": "boolean" },
        "reference_preview": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kind": { "type": "string" },
            "src": { "type": "string" },
            "url": { "type": "string" },
            "specimen_image_src": { "type": "string" },
            "specimen_image_sha256": { "type": "string" },
            "source_label": { "type": "string" },
            "buy_or_license_url": { "type": "string" },
            "license_or_terms_note": { "type": "string" },
            "captured_at": { "type": "string" },
            "alt": { "type": "string" }
          }
        },
        "asset_href": {
          "type": "string",
          "not": { "pattern": "^(?:[a-zA-Z][a-zA-Z0-9+.-]*:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$))" }
        }
      }
    },
    "fontOption": {
      "type": "object",
      "required": ["id", "tier", "label", "name", "headline_font", "body_font", "label_font", "fallback_stack", "sample_headline", "sample_body", "best_use", "why_london_chose_it", "why_this_route_not_other_route", "what_makes_it_wrong", "import_hint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["safe_local", "open_public", "premium_inspiration"] },
        "label": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "headline_font": { "type": "string", "minLength": 1 },
        "body_font": { "type": "string", "minLength": 1 },
        "label_font": { "type": "string", "minLength": 1 },
        "fallback_stack": { "type": "string", "minLength": 1 },
        "sample_headline": { "type": "string" },
        "sample_body": { "type": "string" },
        "best_use": { "type": "string" },
        "why_london_chose_it": { "type": "string" },
        "why_this_route_not_other_route": { "type": "string", "minLength": 1 },
        "what_makes_it_wrong": { "type": "string" },
        "import_hint": { "type": "string" },
        "font_preview": { "$ref": "#/$defs/fontPreview" }
      }
    },
    "moodboardRouteGroup": {
      "type": "object",
      "required": ["route_id", "route_title", "tiles"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "route_title": { "type": "string", "minLength": 1 },
        "tiles": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/moodboardTile" }
        }
      }
    },
    "moodboardTile": {
      "type": "object",
      "required": ["id", "kind", "title", "caption", "span", "annotation", "constraint_tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "asset_src": { "type": "string" },
        "asset_alt": { "type": "string" },
        "prompt": { "type": "string" },
        "copy_label": { "type": "string" },
        "colors": { "type": "array", "items": { "$ref": "#/$defs/paletteColor" } },
        "sample": { "type": "string" },
        "span": { "type": "string" },
        "annotation": { "type": "string" },
        "constraint_tags": { "type": "array", "items": { "type": "string" } },
        "tension_pair": {
          "type": "object",
          "properties": {
            "wants": { "type": "string" },
            "avoid": { "type": "string" }
          }
        }
      }
    },
    "copyBlock": {
      "type": "object",
      "required": ["id", "scope", "kind", "label", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["global", "route"] },
        "route_id": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "nextStep": {
      "type": "object",
      "required": ["id", "label", "description", "action_type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "action_type": { "type": "string", "minLength": 1 },
        "target_route_id": { "type": "string" }
      }
    },
    "evidenceSummary": {
      "type": "object",
      "required": ["brain", "sources", "providers", "receipts", "live_artifacts", "source_claim"],
      "properties": {
        "brain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_class", "findings"],
            "properties": {
              "gate_id": { "type": "string" },
              "gate": { "type": "string" },
              "finding_count": { "type": "integer", "minimum": 0 },
              "evidence_class": { "const": "London Brain Finding" },
              "findings": { "type": "array", "items": { "$ref": "#/$defs/brainFinding" } }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "title", "status", "evidence_class"],
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "notes": { "type": "array", "items": { "type": "string" } },
              "status": { "type": "string", "minLength": 1 },
              "evidence_class": { "const": "Source Target" },
              "claim": { "type": "string" },
              "why_london_used_this": { "type": "string" }
            }
          }
        },
        "providers": { "type": "array", "items": { "type": "object" } },
        "receipts": { "type": "array", "items": { "$ref": "#/$defs/receipt" } },
        "live_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_class", "status"],
            "properties": {
              "evidence_class": { "const": "Live Artifact" },
              "status": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "source_claim": { "type": "string", "minLength": 1 }
      }
    },
    "visualRoute": {
      "type": "object",
      "required": ["id", "title", "headline", "palette", "assets", "approval_state"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "headline": { "type": "string" },
        "subhead": { "type": "string" },
        "palette": {
          "type": "array",
          "items": { "$ref": "#/$defs/paletteColor" }
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/routeAsset" }
        },
        "approval_state": { "type": "string" },
        "source_inspiration": {
          "type": "array",
          "items": { "type": "string" }
        },
        "build_implications": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "paletteColor": {
      "type": "object",
      "required": ["role", "name", "hex"],
      "properties": {
        "role": { "type": "string" },
        "name": { "type": "string" },
        "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "routeAsset": {
      "type": "object",
      "required": ["title", "alt", "kind"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "caption": { "type": "string" },
        "kind": { "type": "string" },
        "provider": { "type": "string" },
        "requested_provider": { "type": "string" },
        "generation_status": { "type": "string" },
        "generation_mode": { "type": "string" },
        "model": { "type": "string" },
        "receipt_id": { "type": "string" },
        "prompt": { "type": "string" },
        "prompt_ref": { "type": "string" },
        "copy_label": { "type": "string" },
        "evidence_class": { "type": "string" },
        "deterministic": { "type": "boolean" },
        "live_artifact": { "type": "boolean" }
      }
    },
    "brainFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "title", "body", "source_ref"],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "source_ref": {
          "type": "string",
          "not": { "pattern": "\\.mp4$" }
        },
        "evidence_class": {
          "type": "string",
          "pattern": "^London Brain Finding"
        },
        "insight_title": { "type": "string" },
        "why_london_used_this": { "type": "string" },
        "source_description": { "type": "string" },
        "topics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": { "type": "object" },
        "score": { "type": "number" },
        "matched_terms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "debug": {
          "type": "object",
          "properties": {
            "source_ref": { "type": "string" },
            "category": { "type": "string" },
            "score": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    },
    "gateState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_name",
        "order",
        "user_answers",
        "brain_queries",
        "sources_inspected",
        "decisions",
        "approvals",
        "receipts"
      ],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "gate_name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "user_answers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "minProperties": 1
        },
        "brain_queries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/brainQuery" }
        },
        "sources_inspected": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceInspection" }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision" }
        },
        "approvals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/approval" }
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/receipt" }
        },
        "brain_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/brainFinding" }
        }
      }
    },
    "brainQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "intent"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 }
      }
    },
    "sourceInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "path", "notes"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_class": { "const": "Source Target" },
        "status": { "type": "string" },
        "why_london_used_this": { "type": "string" }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "path"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "summary", "rationale", "artifacts", "evidence"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approver", "notes"],
      "properties": {
        "status": { "enum": ["approved", "needs_revision", "blocked"] },
        "approver": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "kind", "summary", "deterministic", "provider"],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "requested_provider": { "type": "string" },
        "resolved_provider": { "type": "string" },
        "fallback_chain": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "selection_reason": { "type": "string" },
        "spend_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "estimated_cost_usd": { "type": "number" },
        "request_config": {
          "type": "object",
          "additionalProperties": true
        },
        "attempted_request_configs": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "model": { "type": "string" },
        "image_quality": { "type": "string" },
        "asset_src": { "type": "string" },
        "asset_sha256": { "type": "string" },
        "route_id": { "type": "string" },
        "route_title": { "type": "string" },
        "status": { "type": "string" },
        "generation_mode": { "type": "string" },
        "secrets_printed": { "type": "boolean" },
        "prompt": { "type": "string" },
        "prompt_ref": { "type": "string" },
        "failure": { "type": "string" },
        "error_class": { "type": "string", "enum": ["auth", "quota", "network", "bad_request", "timeout", "no_artifact"] },
        "evidence_used": {
          "type": "object",
          "properties": {
            "brain_findings": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "source_principles": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "grader": {
      "type": "object",
      "description": "Engine-grader block (GRADE-02, Plan 03). The STANDALONE objective instrument — London does not grade his own homework. Carries: a weighted COMPOSITE object (a 0–100 hero score or \"n/a\" + the documented weights + named sub-scores), the named INSPECTORS (Source Auditor / Grounding Inspector / Distinctness Referee / Output Manifest / Type Selection Referee, each a transcript-/output-measurable verdict), the claim-integrity AUDIT (show-verified-only + a visible CLAIM_UNVERIFIED flag), the scrubbed TELEMETRY receipts (query strings + source-… IDs + counts ONLY — never raw findings bodies/paths/secrets), and the two-layer HEADLINE/DETAIL copy (D-09 progressive disclosure as data). Tightened to additionalProperties:false (Phase-5.3 honesty gate — the grader block must not admit fabricated/extra keys); the inner data stays open-list (count=len) but no stray top-level key. Receipts pass the single scrub_pack chokepoint.",
      "additionalProperties": false,
      "required": ["composite", "inspectors", "audit"],
      "properties": {
        "composite": {
          "type": "object",
          "description": "The transparent weighted roll-up. score is a 0–100 number OR the string \"n/a\" (captured=False — the engine grade is unavailable, NOT a fabricated number).",
          "additionalProperties": true,
          "required": ["score", "sub_scores", "weights"],
          "properties": {
            "score": {
              "oneOf": [
                { "type": "number" },
                { "type": "string", "enum": ["n/a"] }
              ]
            },
            "sub_scores": { "type": "object", "additionalProperties": true },
            "weights": { "type": "object", "additionalProperties": true },
            "telemetry_available": { "type": "boolean" },
            "method": { "type": "string" }
          }
        },
        "inspectors": {
          "type": "array",
          "description": "The named objective inspectors (count=len, open-list). Each carries a name, the objective dimension it grades, a sub-score (number or \"n/a\"), and a verdict.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "dimension", "score", "verdict"],
            "properties": {
              "key": { "type": "string" },
              "name": { "type": "string" },
              "dimension": { "type": "string" },
              "score": {
                "oneOf": [
                  { "type": "number" },
                  { "type": "string", "enum": ["n/a"] }
                ]
              },
              "verdict": { "type": "string" }
            }
          }
        },
        "audit": {
          "type": "object",
          "description": "Claim integrity (D-06): only transcript-verified source IDs are grounded; cited-but-unverified IDs are dropped from grounded AND listed in claim_unverified (lighting CLAIM_UNVERIFIED). When telemetry was not captured, the audit is explicitly TELEMETRY_UNAVAILABLE rather than fabricating verification. Never hard-fails.",
          "additionalProperties": false,
          "required": ["grounded_source_ids", "claim_unverified", "verdict"],
          "properties": {
            "grounded_source_ids": { "type": "array", "items": { "type": "string" } },
            "claim_unverified": { "type": "array", "items": { "type": "string" } },
            "verdict": { "type": "string", "enum": ["CLAIM_OK", "CLAIM_UNVERIFIED", "TELEMETRY_UNAVAILABLE"] }
          }
        },
        "telemetry": { "type": "object", "additionalProperties": true },
        "headline": { "type": "object", "additionalProperties": true },
        "detail": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
